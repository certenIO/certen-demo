{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,

    // Mirror of the `@engine` alias in vite.config.ts. Without it `tsc --noEmit` cannot resolve
    // the shared scenario engine the static build imports, so `npm run typecheck` reported four
    // phantom errors while `vite build` succeeded — the worst kind of broken gate.
    "baseUrl": ".",
    "paths": {
      "@engine/*": ["../orchestrator/src/*"]
    }
  },
  "include": ["src"]
}
